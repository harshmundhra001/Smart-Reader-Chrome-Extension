{
  "name": "smart-reader-chrome-extension",
  "version": "1.0.0",
  "description": "A Chrome extension that reads selected text aloud with customizable speech settings",
  "main": "dist/content/smart-reader.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rimraf dist",
    "rebuild": "npm run clean && npm run build",
    "type-check": "tsc --noEmit",
    "lint": "eslint content/**/*.ts utils/**/*.ts --ext .ts",
    "lint:fix": "eslint content/**/*.ts utils/**/*.ts --ext .ts --fix"
  },
  "keywords": [
    "chrome-extension",
    "text-to-speech",
    "accessibility",
    "reading",
    "typescript"
  ],
  "author": "Smart Reader Team",
  "license": "MIT",
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}